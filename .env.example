# Resend（https://resend.com）API キー。ローカルは .env.local、本番は Vercel の Environment Variables に設定。
RESEND_API_KEY=

# --- 本番（ドメイン認証後）---
# 1) resend.com/domains で earth-savers.org を Verified にする
# 2) 送信元（認証済みドメインのメール必須）
RESEND_FROM=地球防衛群 <noreply@earth-savers.org>
# 3) お問い合わせの受信先（省略時も API 既定は info@earth-savers.org）
CONTACT_TO_EMAIL=info@earth-savers.org
# Stripe 継続寄付の完了・変更・停止の運営控え（省略時は CONTACT_TO_EMAIL → info@earth-savers.org）
STRIPE_NOTIFICATION_TO_EMAIL=info@earth-savers.org

# --- ドメイン認証「前」のローカル検証だけ ---
# このときは From を onboarding@resend.dev のまま、To を Resend アカウントの自分のメールにする必要あり:
# CONTACT_TO_EMAIL=あなた@gmail.com

# トラブル: 「自分のメールアドレスにしか送れない」→ まだテストモード。上記 1) のドメイン認証を先に完了。
# 届かない → 迷惑メール・Resend の Emails / Logs を確認。
# お問い合わせAPIは (1) 運営宛通知 (2) お客様宛の受付確認メール の2通を送る。

# --- 都度寄付（銀行）---
# 同じ内容が (1) /join/bank-donation の「振込先口座」に表示（サーバー描画）(2) /contact?intent=bank-donation の自動返信メール に使われる。
# 改行可。未設定のときは案内ページはフォーム誘導のみ・メールは一般の受付文面にフォールバック。
BANK_TRANSFER_DETAILS=銀行名：〇〇銀行\n支店：〇〇支店\n口座種別：普通\n口座番号：1234567\n口座名義：ツウダンホウジン　チキュウボウエイグン
# 任意（件名・前文・末尾を変えたいとき）
# BANK_DONATION_REPLY_SUBJECT=【地球防衛群】都度寄付（銀行振込・郵便振替）のご案内
# BANK_DONATION_REPLY_INTRO=この度は…（複数行OK）
# BANK_DONATION_REPLY_FOOTER=※ …（複数行OK）

# --- Stripe 継続寄付（マンスリーサポーター）---
# Test: https://dashboard.stripe.com/test/products
# Live: https://dashboard.stripe.com/products
# 本番は必ず live mode の sk_live / pk_live / price_ / whsec_ / Portal URL を入れる。
# test と live の値を混在させないこと。
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_TANE=price_...
STRIPE_PRICE_MIDORI=price_...
STRIPE_PRICE_MIZU=price_...
STRIPE_PRICE_MORI=price_...
STRIPE_PRICE_YAMA=price_...
STRIPE_PRICE_NANA=price_...
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/test_...

# Supabase（Webhook → memberships 書き込み用・service role）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- 障害通知・DB keepalive ---
# 障害通知の宛先（省略時は STRIPE_NOTIFICATION_TO_EMAIL → CONTACT_TO_EMAIL → info@earth-savers.org）
# OPS_ALERT_TO_EMAIL=
#
# Vercel Cron の呼び出し検証用。Production に設定すると
# Vercel が Authorization: Bearer <値> を付けて /api/cron/keepalive を叩く。
# 未設定でも x-vercel-cron ヘッダで最低限の検証はするが、設定を推奨。
# CRON_SECRET=
#
# 背景: Supabase 無料プランは 7 日間アイドルでプロジェクトを自動停止する。
# 停止すると Stripe Webhook が全て 500 になり寄付が記録されない（2026-08-10〜13 に実発生）。
#
# 【重要】Vercel Cron は Hobby プランでは実行保証が無い。
# 2026-08-23 の実測で、vercel.json の定義も Cron Jobs の Enabled も正しいのに
# 直近 72 時間の自動実行が 0 回だった。これを予防策として当てにしないこと。
# vercel.json の cron 定義は、ダッシュボードの手動 Run ボタンを残すために維持している。
#
# 予防の本体は公開ヘルスチェック /api/health（認証なし）。
# 外部の監視サービス（UptimeRobot / cron-job.org 等）から 15 分〜1 時間おきに叩き、
# DB をアイドルにさせない。同時に「寄付が通る経路」の死活監視も兼ねる
# （トップページの Uptime 監視は静的配信のため、DB 障害中も 200 を返し続ける）。

# Checkout / Portal の success・cancel URL 用。
# 本番では必須。production で未設定だと localhost へフォールバックせずエラーにする。
SITE_URL=http://localhost:3000
# Production:
# SITE_URL=https://earth-savers.org
# NEXT_PUBLIC_SITE_URL=https://earth-savers.org

# --- Google Search Console / Google Analytics 4（任意）---
# Search Console のHTMLタグ認証で発行された content 属性の値だけを入れる（秘密情報ではない）。
# 例: <meta name="google-site-verification" content="abc123"> の abc123
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
#
# GA4の測定ID。Productionだけに設定すると本番アクセスのみを計測する。
# 値は G- から始まるID（例: G-XXXXXXXXXX）。未設定または形式不正ならタグは読み込まない。
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
#
# Stripe API version は src/lib/stripe/client.ts の STRIPE_API_VERSION に固定
# （Dashboard default: 2026-03-25.dahlia、2026-05-31 時点は 2026-04-22.dahlia へアップグレード可能だが未適用）
#
# --- Rate limit（任意・本番推奨）---
# 設定時のみ Upstash Redis で Checkout / Portal の rate limit を共有する。
# 未設定時はプロセス内メモリ fallback。
# Vercel Marketplace integration (preferred)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Legacy Upstash integration (fallback)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Sentry（Developer プラン・任意）---
# DSN 未設定時は SDK 初期化のみで送信しない。
# サーバー／Edge: SENTRY_DSN
# ブラウザ（instrumentation-client）: NEXT_PUBLIC_SENTRY_DSN が必要
#   （NEXT_PUBLIC_ なしの変数はクライアントバンドルに露出しない）
# Production / Preview では両方に同じ DSN 値を設定する（実値は Vercel env のみ）。
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_ENVIRONMENT=preview
#
# Preview / Production 受信確認:
# - ブラウザ実機: DevTools で一時的に例外を投げ、Sentry Issues を確認（推奨）
# - テストルート GET /api/internal/sentry-test は、Vercel Preview / Production では
#   NODE_ENV=production のため下記2つ両方が必要（Production では ENABLE を入れない）:
#   SENTRY_DSN=...
#   SENTRY_ENABLE_TEST_ROUTE=1
# - ローカル dev のみ SENTRY_DSN があれば test route 有効（ENABLE 不要）
# Production への SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN / ENABLE 設定はマスター承認後。
